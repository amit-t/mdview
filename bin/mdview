#!/usr/bin/env zsh
# mdview — preview a markdown (or MDX) file in the browser (or terminal).
#
# Usage:
#   mdview FILE [-b|-t|-p] [-o PATH] [-n] [--mdx|--md] [--app APP] [--title T]
#   mdview - [opts]              # read markdown from stdin
#   mdview -h | --help
#   mdview -V | --version
#
# Modes:
#   -b, --browser       Render to HTML, open in default browser (default)
#   -t, --terminal      Render in terminal (glow > mdcat > bat > pager)
#   -p, --print         Print rendered HTML to stdout (no open, no file)
#
# Options:
#   -o, --output PATH   Save HTML to PATH instead of an auto temp file
#   -n, --no-open       Write HTML to disk but do not launch the browser
#       --mdx           Treat input as MDX (Markdown + JSX). Auto-detected
#                       for *.mdx files; use this to force it for stdin/.md.
#       --md            Treat input as plain Markdown (overrides .mdx).
#       --app APP       Open in a specific browser (e.g. "Google Chrome",
#                       "Safari", "Firefox"). Default: macOS `open` chooses.
#       --title TITLE   Override <title>. Default: file basename.
#   -h, --help          Show this help.
#   -V, --version       Show version.
#
# Renderer chain for HTML output:
#   1. pandoc (if installed) — fully offline, GitHub style.
#   2. Fallback: client-side render with marked.js + github-markdown-css +
#      highlight.js loaded from a CDN. The raw markdown is embedded in a
#      hidden <textarea> (HTML-escaped) so it survives any content safely.
#
# MDX files (*.mdx, or any input with --mdx) bypass the chain above and are
# rendered client-side with @mdx-js/mdx + React (ESM from a CDN), so JSX,
# components and { expressions } evaluate. If that fails (e.g. unresolved
# local imports), it degrades to a markdown-only preview. The same
# HTML-escaped <textarea> embedding is used, so the security property holds.

emulate -L zsh
set -euo pipefail

readonly MDVIEW_VERSION="1.0.0"

# Capture script path before any function runs — inside zsh functions, $0
# refers to the function name (FUNCTION_ARGZERO is on by default).
script_path=${0:A}
prog=${script_path:t}

usage() {
    awk '
        NR == 1 && /^#!/ { next }
        /^[^#]/ { exit }
        { sub(/^# ?/, ""); print }
    ' "$script_path"
}

die() { print -ru2 -- "${prog}: $1"; exit "${2:-1}"; }

# ---------- arg parsing -----------------------------------------------------
mode="browser"
file=""
output=""
no_open=0
app=""
title=""
force_fmt=""   # "", "mdx", or "md"

while (( $# > 0 )); do
    case "$1" in
        -h|--help)      usage; exit 0 ;;
        -V|--version)   print -r -- "mdview ${MDVIEW_VERSION}"; exit 0 ;;
        -b|--browser)   mode="browser"; shift ;;
        -t|--terminal)  mode="terminal"; shift ;;
        -p|--print)     mode="print"; shift ;;
        -n|--no-open)   no_open=1; shift ;;
        --mdx)          force_fmt="mdx"; shift ;;
        --md|--markdown) force_fmt="md"; shift ;;
        -o|--output)    (( $# >= 2 )) || die "--output needs a path"
                        output="$2"; shift 2 ;;
        --app)          (( $# >= 2 )) || die "--app needs a name"
                        app="$2"; shift 2 ;;
        --title)        (( $# >= 2 )) || die "--title needs a value"
                        title="$2"; shift 2 ;;
        --)             shift; break ;;
        -)              # bare dash → positional, means stdin
                        [[ -z "$file" ]] || die "extra arg: -" 2
                        file="-"; shift ;;
        -*)             die "unknown flag: $1 (try --help)" 2 ;;
        *)              [[ -z "$file" ]] || die "extra arg: $1" 2
                        file="$1"; shift ;;
    esac
done

[[ -n "$file" ]] || { usage >&2; exit 2 }

# ---------- read source -----------------------------------------------------
if [[ "$file" = "-" ]]; then
    md_content=$(cat)
    src_label="stdin"
else
    [[ -f "$file" ]] || die "no such file: $file"
    md_content=$(cat -- "$file")
    src_label=${file:t}
fi
[[ -n "$title" ]] || title="$src_label"

# ---------- format selection (markdown vs MDX) ------------------------------
# .mdx files auto-select MDX; --mdx / --md override (stdin defaults to md).
is_mdx=0
case "$force_fmt" in
    mdx) is_mdx=1 ;;
    md)  is_mdx=0 ;;
    *)   [[ "$file" != "-" && "${file:l}" == *.mdx ]] && is_mdx=1 ;;
esac

# ---------- helpers ---------------------------------------------------------
html_escape() {
    # Escape &, <, >, ", ' for safe insertion into HTML attributes & text.
    print -rn -- "$1" \
        | sed -e 's/&/\&amp;/g' \
              -e 's/</\&lt;/g' \
              -e 's/>/\&gt;/g' \
              -e 's/"/\&quot;/g' \
              -e "s/'/\&#39;/g"
}

# Escape only & and < for embedding inside <textarea>.
# textarea is an "escapable raw text" element — only </textarea> closes it,
# so escaping < eliminates that risk and & ensures correct &lt; round-trip.
textarea_escape() {
    print -rn -- "$1" \
        | sed -e 's/&/\&amp;/g' \
              -e 's/</\&lt;/g'
}

# ---------- terminal mode ---------------------------------------------------
if [[ "$mode" = "terminal" ]]; then
    # Terminal renderers only understand Markdown. For MDX, drop the ESM
    # import/export statement lines so the prose renders cleanly, then always
    # feed the cleaned text via stdin (JSX tags are left as-is, shown literal).
    t_file="$file"
    t_content="$md_content"
    if (( is_mdx )); then
        t_content=$(print -r -- "$md_content" \
            | sed -E '/^[[:space:]]*(import|export)[[:space:]].*$/d')
        t_file="-"
    fi
    if (( $+commands[glow] )); then
        if [[ "$t_file" = "-" ]]; then print -rn -- "$t_content" | glow -
        else glow -- "$t_file"; fi
    elif (( $+commands[mdcat] )); then
        if [[ "$t_file" = "-" ]]; then print -rn -- "$t_content" | mdcat
        else mdcat -- "$t_file"; fi
    elif (( $+commands[bat] )); then
        if [[ "$t_file" = "-" ]]; then
            print -rn -- "$t_content" | bat -l md --paging=never
        else
            bat -l md --paging=never -- "$t_file"
        fi
    else
        # Plain pager fallback — preserves content even with no renderer.
        local pager="${PAGER:-less -R}"
        print -r -- "$t_content" | eval "$pager"
    fi
    exit 0
fi

# ---------- HTML render -----------------------------------------------------
title_html=$(html_escape "$title")

render_with_pandoc() {
    local body
    if [[ "$file" = "-" ]]; then
        body=$(print -rn -- "$md_content" | pandoc -f gfm -t html)
    else
        body=$(pandoc -f gfm -t html -- "$file")
    fi
    cat <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>${title_html}</title>
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/github-markdown-css@5.5.1/github-markdown.min.css">
<style>
  body { box-sizing: border-box; min-width: 200px; max-width: 920px;
         margin: 0 auto; padding: 32px 48px; }
  @media (prefers-color-scheme: dark) {
    body { background: #0d1117; }
  }
</style>
</head>
<body class="markdown-body">
${body}
</body>
</html>
HTML
}

render_with_marked() {
    local md_escaped
    md_escaped=$(textarea_escape "$md_content")
    cat <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>${title_html}</title>
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/github-markdown-css@5.5.1/github-markdown.min.css">
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github.min.css">
<style>
  body { box-sizing: border-box; min-width: 200px; max-width: 920px;
         margin: 0 auto; padding: 32px 48px; }
  @media (prefers-color-scheme: dark) {
    body { background: #0d1117; }
  }
  pre code.hljs { display:block; overflow:auto; padding:1em; border-radius:6px; }
  #md-source { display:none; }
  #fallback { white-space: pre-wrap; font-family: ui-monospace, monospace;
              padding: 16px; background:#f6f8fa; border-radius:6px; }
</style>
</head>
<body>
<article id="content" class="markdown-body"><p>Loading preview…</p></article>
<noscript>
  <p><strong>JavaScript is disabled.</strong> Showing raw markdown:</p>
  <pre id="fallback">${md_escaped}</pre>
</noscript>
<textarea id="md-source" readonly aria-hidden="true">${md_escaped}</textarea>
<script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/highlight.min.js"></script>
<script>
  (function () {
    var raw = document.getElementById('md-source').value;
    var content = document.getElementById('content');
    if (!window.marked) {
      var pre = document.createElement('pre');
      pre.textContent = raw;
      content.innerHTML = '';
      content.appendChild(pre);
      return;
    }
    marked.setOptions({
      gfm: true,
      breaks: false,
      headerIds: true,
      highlight: function (code, lang) {
        if (window.hljs) {
          try {
            return lang && hljs.getLanguage(lang)
              ? hljs.highlight(code, { language: lang }).value
              : hljs.highlightAuto(code).value;
          } catch (e) { /* fall through */ }
        }
        return code;
      }
    });
    content.innerHTML = marked.parse(raw);
  })();
</script>
</body>
</html>
HTML
}

render_mdx() {
    local md_escaped
    md_escaped=$(textarea_escape "$md_content")
    cat <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>${title_html}</title>
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/github-markdown-css@5.5.1/github-markdown.min.css">
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github.min.css">
<style>
  body { box-sizing: border-box; min-width: 200px; max-width: 920px;
         margin: 0 auto; padding: 32px 48px; }
  @media (prefers-color-scheme: dark) {
    body { background: #0d1117; }
  }
  pre code.hljs { display:block; overflow:auto; padding:1em; border-radius:6px; }
  #md-source { display:none; }
  #notice { display:none; margin:0 0 16px; padding:10px 14px; border-radius:6px;
            background:#fff8c5; border:1px solid #d4a72c; color:#3b2300;
            font:14px/1.5 ui-sans-serif, system-ui, sans-serif; }
  @media (prefers-color-scheme: dark) {
    #notice { background:#2d2200; border-color:#9e6a03; color:#f2cc60; }
  }
  #content { min-height: 1em; }
  #fallback { white-space: pre-wrap; font-family: ui-monospace, monospace;
              padding: 16px; background:#f6f8fa; border-radius:6px; }
</style>
<script type="importmap">
{ "imports": {
  "react": "https://esm.sh/react@18",
  "react-dom": "https://esm.sh/react-dom@18",
  "react-dom/client": "https://esm.sh/react-dom@18/client",
  "react/jsx-runtime": "https://esm.sh/react@18/jsx-runtime",
  "@mdx-js/react": "https://esm.sh/@mdx-js/react@3"
}}
</script>
</head>
<body>
<div id="notice" class="markdown-body" role="status"></div>
<article id="content" class="markdown-body"><p>Loading MDX preview…</p></article>
<noscript>
  <p><strong>JavaScript is disabled.</strong> Showing raw MDX source:</p>
  <pre id="fallback">${md_escaped}</pre>
</noscript>
<textarea id="md-source" readonly aria-hidden="true">${md_escaped}</textarea>
<script type="module">
  import React from 'react';
  import { createRoot } from 'react-dom/client';
  import * as runtime from 'react/jsx-runtime';
  import { evaluate } from 'https://esm.sh/@mdx-js/mdx@3?bundle';

  const raw = document.getElementById('md-source').value;
  const content = document.getElementById('content');
  const notice = document.getElementById('notice');

  function showNotice(msg) {
    notice.textContent = msg;
    notice.style.display = 'block';
  }

  async function fallbackMarkdown(reason) {
    showNotice('Full MDX render failed (' + reason + '). Showing a markdown-only '
      + 'preview; interactive components are omitted.');
    try {
      const mod = await import('https://esm.sh/marked@12');
      const marked = mod.marked || mod.default;
      const cleaned = raw.replace(/^[ \t]*(import|export)\b[^\n]*$/gm, '');
      content.innerHTML = marked.parse(cleaned);
    } catch (e) {
      const pre = document.createElement('pre');
      pre.textContent = raw;
      content.innerHTML = '';
      content.appendChild(pre);
    }
  }

  (async function () {
    try {
      const mod = await evaluate(raw, Object.assign({}, runtime, { baseUrl: location.href }));
      const MDXContent = mod.default;
      content.innerHTML = '';
      createRoot(content).render(React.createElement(MDXContent, {}));
    } catch (err) {
      await fallbackMarkdown(err && err.message ? err.message : String(err));
    }
  })();
</script>
</body>
</html>
HTML
}

if (( is_mdx )); then
    html=$(render_mdx)
elif (( $+commands[pandoc] )); then
    html=$(render_with_pandoc)
else
    html=$(render_with_marked)
fi

# ---------- print mode ------------------------------------------------------
if [[ "$mode" = "print" ]]; then
    print -r -- "$html"
    exit 0
fi

# ---------- write file ------------------------------------------------------
if [[ -z "$output" ]]; then
    tmpdir=$(mktemp -d -t mdview)
    safe_label=$(print -rn -- "$src_label" | tr -c 'A-Za-z0-9._-' '_')
    base=${safe_label%.mdx}
    base=${base%.md}
    output="$tmpdir/${base}.html"
fi

print -r -- "$html" > "$output"
print -r -- "$output"

# ---------- launch browser --------------------------------------------------
if (( no_open == 0 )); then
    if [[ -n "$app" ]]; then
        open -a "$app" "$output"
    else
        open "$output"
    fi
fi
